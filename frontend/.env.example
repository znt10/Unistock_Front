# Copie para .env.local e ajuste. NUNCA commite o .env.local.
# O docker-compose faz env_file: .env.local, entao o arquivo precisa existir
# mesmo que vazio pra subir o container.

# Destino do rewrite /backend/* (ver next.config.ts).
# O front nunca chama a API direto: tudo passa pelo proprio dominio pra que
# os cookies HTTP-only do Django virem first-party.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Opcional; tem prioridade sobre a de cima. Util quando o destino interno
# difere do publico. No docker-compose ja vem definido como http://api:8000
# (nome do servico do Django na rede do compose) — nao usar localhost la,
# que dentro do container aponta pro proprio frontend.
# API_PROXY_URL=http://api:8000

# Opcional; > 0 liga o polling do Turbopack (ver next.config.ts). Necessario
# so em bind mount do Windows, onde o inotify nao propaga. No docker-compose
# ja vem definido como 1000. Rodando direto no host, deixe vazio.
# NEXT_WATCH_POLL_MS=1000
